# KSquad console (BFF) — server-only configuration.
#
# The console is the one authorization choke point (arch §13 / ADR-013): the browser talks
# ONLY to this Next.js server, which proxies the Go apiserver (REST + SSE). None of these are
# NEXT_PUBLIC_* — the browser must never learn the apiserver URL or hold an apiserver credential.

# Base URL of the Go apiserver the BFF proxies (REST + SSE progress bus). Server-only.
KSQUAD_APISERVER_URL=http://ksquad-apiserver:8080

# Name of the HttpOnly session cookie the BFF forwards upstream (arch §12.3 / ADR-033).
# The apiserver mints the internal JWT from this session; the BFF adds no second authz path.
KSQUAD_SESSION_COOKIE=ksquad_session
