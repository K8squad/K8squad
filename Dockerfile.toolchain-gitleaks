# syntax=docker/dockerfile:1
# gitleaks toolchain image (ISI-5768, skill-catalog expansion ISI-5754 §3.6).
# Minimal binary-staging image. gitleaks ships as a static Go binary; staged from
# the GitHub release via a per-arch tarball. Already used in the main-repo CI pipeline
# (L4 secret-scan gate — ISI-5768 note: Gitleaks L4 flags literal PEM in tests).
# Multi-arch: linux/amd64 + linux/arm64 via TARGETARCH (buildx).
FROM alpine:3.21 AS fetch
ARG GITLEAKS_VERSION=8.24.0
ARG TARGETARCH
RUN apk add --no-cache curl \
 && ARCH="${TARGETARCH}" \
 && [ "${ARCH}" = "amd64" ] && ARCH="x86_64" || ARCH="arm64" \
 && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_${ARCH}.tar.gz" \
      -o /tmp/gitleaks.tar.gz \
 && tar -xzf /tmp/gitleaks.tar.gz -C /usr/local/bin gitleaks \
 && chmod 0755 /usr/local/bin/gitleaks \
 && rm /tmp/gitleaks.tar.gz

FROM alpine:3.21
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="k8squad toolchain: gitleaks"
COPY --from=fetch /usr/local/bin/gitleaks /usr/local/bin/gitleaks
ENTRYPOINT ["/usr/local/bin/gitleaks"]
