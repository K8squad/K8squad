# syntax=docker/dockerfile:1.9
# ksquad-shim-<runtime> — A2A⇄native sidecar, one image per AgentRuntime.type.
#
# The image folds THREE things onto $PATH:
#   1. /usr/local/bin/shim   — the generic A2A shim main (cmd/shim), runtime-agnostic.
#   2. the runtime's native CLI — staged per-RUNTIME by the cli-<runtime> stages below.
#   3. any runtime-specific entrypoint wrapper (e.g. ksquad-codex-exec for codex).
#
# RUNTIME selects which CLI layer is baked in (`FROM cli-${RUNTIME}`). It is NO LONGER
# label-only (ISI-3653 fixes that pre-existing drift). Real CLI packaging today:
#   codex    — static-musl codex@rust-v0.152.0 + ksquad-codex-exec wrapper (ISI-3653)
#   opencode — sst/opencode@v1.18.27 musl tarball, musl/libstdc++ libs staged (ISI-3667)
#   claude   — Claude Code@2.1.236 native binary, sha256-verified (ISI-3667; the shim
#              adapter for claude-code itself remains Phase 2, pkg/shim/runtimes)
# openclaw/hermes are intentionally UNPACKAGED (disposition at their stages, ISI-3667).
# This matches the shim matrix in .github/workflows/component-matrix.yml. An unknown
# RUNTIME fails closed at `FROM cli-${RUNTIME}` (no matching stage).
#
#   docker buildx build -f Dockerfile.shim \
#     --build-arg RUNTIME=codex \
#     --platform linux/amd64,linux/arm64 -t ghcr.io/k8squad/ksquad-shim-codex .

# RUNTIME is consumed in a `FROM` line below, so it must be a GLOBAL arg (declared before
# the first FROM). Re-declared inside the stages that use it in RUN/LABEL.
ARG RUNTIME=reference

# ---- Go build: the generic shim + (always) the codex wrapper -----------------------------
# The wrapper is tiny and stdlib-only; building it unconditionally keeps this file simple.
# It only reaches the final image when RUNTIME=codex selects the cli-codex stage below.
FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/shim ./cmd/shim
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/ksquad-codex-exec ./cmd/ksquad-codex-exec

# ---- CLI-install stages: one per runtime; the final image selects cli-${RUNTIME} ---------
# Each stage populates /cli-out with the binaries to overlay onto the final image's $PATH,
# and /cli-lib with any runtime libs the CLI needs on the distroless/static base (musl
# loader + libc for the dynamic-musl bun CLIs; empty for static/no-op stages). The no-op
# base emits empty dirs so the selector always resolves and the COPYs into the final image
# are harmless no-ops for runtimes with no packaged CLI.
FROM alpine:3.21 AS cli-noop
RUN mkdir -p /cli-out /cli-lib
FROM cli-noop AS cli-reference

# openclaw + hermes — DISPOSITION (ISI-3667 AC4): intentionally NOT packaged. Neither CLI
# has an upstream release artifact to pin: the adapters (pkg/shim/runtimes/openclaw.go,
# hermes.go, story 5.5) target in-development CLI surfaces whose CLIVersion() pins
# (v0.9.0 / v1.2.0) name planned revisions, not downloadable binaries. The stages stay
# empty BY DECISION: an empty /cli-out means the shim fails closed at exec (binary not
# found) rather than masquerading as a working runtime behind a placeholder script.
# Revisit when a real openclaw/hermes artifact channel exists.
FROM cli-noop AS cli-openclaw
FROM cli-noop AS cli-hermes

# opencode (ISI-3667): stage the pinned sst/opencode release the adapter targets
# (opencode.CLIVersion(), ADR-017). Upstream ships bun-compiled per-arch tarballs; the
# *-musl variants are DYNAMICALLY linked against musl + libstdc++ + libgcc (unlike the
# fully-static codex binary), so the stage also exports alpine's musl loader + those libs
# via /cli-lib for the distroless/static final image. `opencode --version` prints the bare
# semver; assert it at build time (mirrors the codex AC1 check).
FROM alpine:3.21 AS cli-opencode
ARG TARGETARCH
ARG OPENCODE_VERSION=v1.18.27
ARG OPENCODE_SEMVER=1.18.27
RUN apk add --no-cache curl ca-certificates libgcc libstdc++
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) ocarch=x64 ;; \
      arm64) ocarch=arm64 ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p /cli-out /cli-lib/lib /cli-lib/usr/lib; \
    curl -fsSL "https://github.com/sst/opencode/releases/download/${OPENCODE_VERSION}/opencode-linux-${ocarch}-musl.tar.gz" \
      -o /tmp/opencode.tar.gz; \
    tar -xzf /tmp/opencode.tar.gz -C /tmp; \
    install -m0755 /tmp/opencode /cli-out/opencode; \
    rm -f /tmp/opencode.tar.gz /tmp/opencode; \
    /cli-out/opencode --version | grep -Fq "${OPENCODE_SEMVER}"; \
    cp -a /lib/ld-musl-*.so.1 /lib/libc.musl-*.so.1 /cli-lib/lib/; \
    for f in /lib/libgcc_s.so.1 /usr/lib/libgcc_s.so.1; do \
      [ ! -f "$f" ] || cp -aL "$f" /cli-lib/usr/lib/; \
    done; \
    cp -aL /usr/lib/libstdc++.so.6 /cli-lib/usr/lib/; \
    test -f /cli-lib/usr/lib/libgcc_s.so.1; \
    test -f /cli-lib/usr/lib/libstdc++.so.6

# claude-code (ISI-3667): Anthropic ships the Claude Code CLI as bun-compiled native
# binaries (the same channel claude.ai/install.sh pulls from), with a per-release
# manifest.json carrying sha256 checksums. Pinned, sha256-verified against the pinned
# manifest values, and version-asserted at build time. The binary is dynamic-musl
# (NEEDED: libc.musl only — verified from the ELF dynamic section), so only the musl
# loader pair is staged via /cli-lib. `claude --version` prints "<semver> (Claude Code)".
FROM alpine:3.21 AS cli-claude
ARG TARGETARCH
ARG CLAUDE_VERSION=2.1.236
# sha256 of the pinned release's linux-{x64,arm64}-musl binaries, from
# .../claude-code-releases/${CLAUDE_VERSION}/manifest.json
ARG CLAUDE_SHA256_X64=979acf4877fa3dca24d6d15043022b5005cc8502fdb4c68992dd91651af31731
ARG CLAUDE_SHA256_ARM64=56fe9241267b0187538a9cf7dafa0df12d94fd27789fa7207a59c2a0b4121b8f
RUN apk add --no-cache curl ca-certificates
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) ccplat=linux-x64-musl;   sha="$CLAUDE_SHA256_X64" ;; \
      arm64) ccplat=linux-arm64-musl; sha="$CLAUDE_SHA256_ARM64" ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p /cli-out /cli-lib/lib; \
    base="https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases"; \
    curl -fsSL "$base/${CLAUDE_VERSION}/${ccplat}/claude" -o /tmp/claude; \
    echo "$sha  /tmp/claude" | sha256sum -c -; \
    install -m0755 /tmp/claude /cli-out/claude; \
    rm -f /tmp/claude; \
    /cli-out/claude --version | grep -Fq "${CLAUDE_VERSION}"; \
    cp -a /lib/ld-musl-*.so.1 /lib/libc.musl-*.so.1 /cli-lib/lib/

# codex (ISI-3653 / seam O): stage the pinned static-musl codex CLI + the ksquad-codex-exec
# wrapper. The release tarball ships an arch-suffixed binary (codex-<triple>); we install it
# as `codex`. Note: `codex --version` prints `codex-cli ${CODEX_SEMVER}` while the pinned
# RELEASE TAG is ${CODEX_VERSION} (rust-v…) — the latter equals codex.CLIVersion() in the
# adapter (ADR-017 immutable pin). We assert the numeric version at build time (AC1).
FROM alpine:3.21 AS cli-codex
ARG TARGETARCH
ARG CODEX_VERSION=rust-v0.152.0
ARG CODEX_SEMVER=0.152.0
RUN apk add --no-cache curl ca-certificates
RUN set -eux; \
    case "$TARGETARCH" in \
      amd64) triple=x86_64-unknown-linux-musl ;; \
      arm64) triple=aarch64-unknown-linux-musl ;; \
      *) echo "unsupported TARGETARCH=$TARGETARCH" >&2; exit 1 ;; \
    esac; \
    mkdir -p /cli-out /cli-lib; \
    curl -fsSL "https://github.com/openai/codex/releases/download/${CODEX_VERSION}/codex-${triple}.tar.gz" \
      -o /tmp/codex.tar.gz; \
    tar -xzf /tmp/codex.tar.gz -C /tmp; \
    install -m0755 "/tmp/codex-${triple}" /cli-out/codex; \
    rm -f /tmp/codex.tar.gz; \
    /cli-out/codex --version | grep -Fq "${CODEX_SEMVER}"
COPY --from=build /out/ksquad-codex-exec /cli-out/ksquad-codex-exec

# Select the CLI layer for the requested runtime (fails closed on an unknown RUNTIME).
FROM cli-${RUNTIME} AS cli

# ---- Final image -------------------------------------------------------------------------
FROM gcr.io/distroless/static-debian12:nonroot
ARG RUNTIME=reference
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="ksquad-shim-${RUNTIME}" \
      org.opencontainers.image.description="KSquad A2A shim sidecar (runtime=${RUNTIME})" \
      org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /
# shim first — this creates /usr/local/bin before the (possibly empty) CLI overlay.
COPY --from=build /out/shim /usr/local/bin/shim
COPY --from=cli /cli-out/ /usr/local/bin/
# Runtime libs for dynamic-musl CLIs (opencode, claude): the musl loader pair and, for
# opencode, libstdc++/libgcc. Empty for codex (fully static) and unpackaged runtimes.
COPY --from=cli /cli-lib/ /
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/shim"]
