# syntax=docker/dockerfile:1
# trivy toolchain image (ISI-5768, skill-catalog expansion ISI-5754 §3.6).
# Rebases the official aquasec/trivy image (already minimal/multi-arch, production-
# hardened) so the catalog reference is K8squad-owned, signed, and rebuilt weekly.
# The operator stages `trivy` onto the skill sandbox PATH; standalone ENTRYPOINT = trivy.
ARG TRIVY_IMAGE=aquasec/trivy:0.58.2
FROM ${TRIVY_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="k8squad toolchain: trivy"
ENTRYPOINT ["/usr/local/bin/trivy"]
