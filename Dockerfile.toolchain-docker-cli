# syntax=docker/dockerfile:1
# docker CLI toolchain image (ISI-3413). CLI ONLY — no daemon; the daemon stays the
# existing dockerd sidecar (values.yaml tools comment). Rebases the official
# docker:29-cli variant so the ref is K8squad-owned, signed, and CVE-rebuilt.
ARG DOCKER_IMAGE=docker:29-cli
FROM ${DOCKER_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="k8squad toolchain: docker-cli"
# ISI-3923: pull the current alpine openssl fix (libcrypto3 >= 3.5.8-r0, CVE-2026-14456)
# at build time instead of waiting on the rolling docker:29-cli base ref — same pattern
# as Dockerfile.toolchain-python (ISI-3444).
RUN apk upgrade --no-cache libcrypto3 libssl3
ENTRYPOINT ["/usr/local/bin/docker"]
