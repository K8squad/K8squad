# syntax=docker/dockerfile:1.9
# ksquad-shim-<runtime> — A2A⇄native sidecar, one image per AgentRuntime.type.
# TEMPLATE (Phase 2): the per-runtime build args select which shim main to compile and
# which runtime base layer to stage. Not yet wired into build-images.yml's matrix — the
# shim matrix lands with the A2A conformance suite that owns the runtime list.
#
#   docker buildx build -f Dockerfile.shim \
#     --build-arg RUNTIME=openclaw \
#     --platform linux/amd64,linux/arm64 -t ghcr.io/k8squad/ksquad-shim-openclaw .

FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS build
ARG TARGETOS
ARG TARGETARCH
ARG RUNTIME=reference
WORKDIR /src
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags="-s -w" -o /out/shim ./cmd/shim

FROM gcr.io/distroless/static-debian12:nonroot
ARG RUNTIME=reference
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="ksquad-shim" \
      org.opencontainers.image.description="KSquad A2A shim sidecar (runtime=${RUNTIME})" \
      org.opencontainers.image.licenses="Apache-2.0"
WORKDIR /
COPY --from=build /out/shim /usr/local/bin/shim
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/shim"]
