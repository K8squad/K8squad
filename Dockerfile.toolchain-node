# syntax=docker/dockerfile:1
# Node.js toolchain image (ISI-3413). node + npm/npx staged from the official
# node-alpine image (musl build — runs on the same alpine runtime base).
ARG NODE_IMAGE=node:22-alpine
FROM ${NODE_IMAGE} AS src

FROM alpine:3.21
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="k8squad toolchain: node"
RUN apk add --no-cache libstdc++ ca-certificates
COPY --from=src /usr/local/bin/node /usr/local/bin/node
COPY --from=src /usr/local/lib/node_modules /usr/local/lib/node_modules
# ISI-3444: the npm bundled in node:22-alpine ships tar 7.5.11 (CRITICAL
# CVE-2026-59873) and brace-expansion 2.0.2 (HIGH CVE-2026-13149) — fixable, so the
# Trivy gate fails the leg. Upgrade the bundled npm to a pinned release that carries
# tar >= 7.5.19. ISI-6822 (2026-10-29): npm 12.2.1 bundles tar 7.5.22, brace-expansion 5.0.12,
# ip-address 10.7.2 - clears the 2026-10 suppression batch (CVE-2026-14257/69152/69192/73566),
# verified from the 12.2.1 release tarball.
ARG NPM_VERSION=12.2.1
RUN node /usr/local/lib/node_modules/npm/bin/npm-cli.js install -g "npm@${NPM_VERSION}" \
 && npm cache clean --force
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
ENTRYPOINT ["/usr/local/bin/node"]
