# syntax=docker/dockerfile:1
# ffmpeg toolchain image (ISI-5768, skill-catalog expansion ISI-5754 §3.2 Design).
# Rebases the official linuxserver/ffmpeg image (multi-arch, actively maintained,
# up-to-date ffmpeg + ffprobe + x264/x265/aac codecs) so the catalog reference is
# K8squad-owned, signed, and rebuilt weekly. The operator stages `ffmpeg` + `ffprobe`
# onto the skill sandbox PATH; standalone ENTRYPOINT = ffmpeg. Multi-arch
# (linux/amd64 + linux/arm64) rides the official image's multi-arch manifest.
ARG FFMPEG_IMAGE=linuxserver/ffmpeg:7.1.1
FROM ${FFMPEG_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="k8squad toolchain: ffmpeg"
ENTRYPOINT ["/usr/local/bin/ffmpeg"]
