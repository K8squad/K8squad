# syntax=docker/dockerfile:1
# checkov + kube-bench toolchain image (ISI-5768, skill-catalog expansion ISI-5754 §3.6).
# Provides both checkov (Bridgecrew IaC scanner, pip-installed) and kube-bench (CIS
# Kubernetes benchmarks, static Go binary) on the same image — they pair for the
# `iac-scan` skill (terraform/k8s misconfig). Base: python:3.12-alpine (same line as
# Dockerfile.toolchain-python + Dockerfile.toolchain-ansible-core). Multi-arch
# (linux/amd64 + linux/arm64) rides the python:3.12-alpine multi-arch manifest.
ARG PYTHON_IMAGE=python:3.12-alpine
ARG KUBE_BENCH_VERSION=0.9.4
FROM alpine:3.21 AS bench-fetch
ARG KUBE_BENCH_VERSION
ARG TARGETARCH
RUN apk add --no-cache curl \
 && curl -fsSL "https://github.com/aquasecurity/kube-bench/releases/download/v${KUBE_BENCH_VERSION}/kube-bench_${KUBE_BENCH_VERSION}_linux_${TARGETARCH}.tar.gz" \
      -o /tmp/kb.tar.gz \
 && tar -xzf /tmp/kb.tar.gz -C /tmp \
 && mv /tmp/kube-bench /usr/local/bin/kube-bench \
 && chmod 0755 /usr/local/bin/kube-bench \
 && rm /tmp/kb.tar.gz

FROM ${PYTHON_IMAGE}
ARG CHECKOV_VERSION=3.2.319
LABEL org.opencontainers.image.source="https://github.com/K8squad/K8squad" \
      org.opencontainers.image.title="k8squad toolchain: checkov"
# CVE hygiene: pull current openssl + util-linux fixes (mirrors Dockerfile.toolchain-python).
# upgrade pip/setuptools (setuptools CVE-2025-47273 fixed 78.1.1) before checkov install.
RUN apk upgrade --no-cache libcrypto3 libssl3 util-linux \
 && pip install --no-cache-dir --upgrade "pip" "setuptools>=78.1.1" \
 && pip install --no-cache-dir "checkov==${CHECKOV_VERSION}"
COPY --from=bench-fetch /usr/local/bin/kube-bench /usr/local/bin/kube-bench
ENTRYPOINT ["/usr/local/bin/checkov"]
